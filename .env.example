# Copy this file to ".env" and fill in the values you want to use.

# Which AI provider to use: "openai" or "gemini"
AI_PROVIDER=openai

# OpenAI settings (used if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini settings (used if AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# The app works WITHOUT any API key too - it will fall back to
# rule-based summaries and insights instead of AI-generated ones.
